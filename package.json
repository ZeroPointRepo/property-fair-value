{
  "name": "property-fair-value",
  "private": false,
  "version": "1.0.0",
  "description": "A React demo that estimates a US listing's fair value from its Zestimate and nearby comparable homes using ZillAPI.",
  "keywords": [
    "real-estate",
    "property-valuation",
    "zestimate",
    "comparable-sales",
    "zillapi",
    "react",
    "vite"
  ],
  "homepage": "https://github.com/ZeroPointRepo/property-fair-value#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZeroPointRepo/property-fair-value.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
